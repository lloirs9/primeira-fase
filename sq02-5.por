programa {
  funcao inicio() {
    inteiro numero
    inteiro nuumero
    escreva ("ponha um numero: ")
    leia (numero)
    escreva("ponha um numero: ")
    leia(nuumero)
    se(numero == nuumero){
     escreva("ponha um numero diferente um do outro")
     se (numero > nuumero ){
      escreva("esse e o maior numero")
     }senao{
      escreva("esse e o maior numero")
     }
    }
    
  }
}erro
