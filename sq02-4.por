programa {
  funcao inicio() {
    inteiro numero  
    escreva(" insira um numero de 1 a 7: ")
    leia(numero)

    se(numero == 1){
      escreva("E sabado")
    }
    se(numero == 2){
      escreva("E segunda")
    }
    se(numero == 3){
      escreva("E terça")
    }
    se(numero == 4){
      escreva("E quarta")
    }
    se(numero == 5){
      escreva("E quinta")
    }
    se(numero == 6){
      escreva("E sexta")
    }
    se(numero == 7){
      escreva("E sabado")
    }
  }
  
}
